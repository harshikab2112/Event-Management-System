{
  "info": {
    "name": "Gatherly Event Platform API",
    "description": "End-to-end checks for health, auth, event management, access control, registrations, and validation. The configured ADMIN_EMAIL must match admin_email in the selected Postman environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "event_id",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "member_token",
      "value": ""
    },
    {
      "key": "category_id",
      "value": ""
    },
    {
      "key": "ticket_code",
      "value": ""
    },
    {
      "key": "inquiry_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health reports a connected database', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().database).to.eql('connected'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "OpenAPI specification",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/openapi.json"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Interactive API documentation is backed by OpenAPI 3', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().openapi).to.eql('3.0.3'); pm.expect(pm.response.json().paths).to.have.property('/events/my-registrations'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Register admin (first run creates admin; reruns may return conflict)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Gatherly Admin\",\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
        },
        "url": "{{base_url}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin registration creates the configured admin or safely rejects a duplicate', function () { pm.expect([201,409]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
