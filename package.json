{
  "name": "event-management-system",
  "version": "1.0.0",
  "description": "MERN event platform with a layered Express API, JWT authentication, MongoDB Atlas, and a React dashboard.",
  "main": "backend/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "nodemon backend/server.js",
    "dev:web": "node scripts/wait-for-api.js",
    "build": "npm --prefix frontend run build",
    "seed": "node database/seeds/seed.js",
    "seed:replace-events": "node database/seeds/replace-events.js --confirm-replace-events",
    "seed:demo-data": "node database/seeds/seed-related-demo-data.js",
    "test:api": "node scripts/test-postman.js"
  },
  "keywords": [
    "event-management",
    "mern",
    "react",
    "express",
    "mongodb",
    "jwt",
    "mvc"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.6.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "mongodb-memory-server": "^11.3.0",
    "newman": "^6.2.3",
    "nodemon": "^3.1.9"
  }
}