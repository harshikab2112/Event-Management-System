PORT=3000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/gatherly?retryWrites=true&w=majority
MONGODB_DB_NAME=event_management_system
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@example.test
OTP_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=Gatherly <no-reply@example.com>
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
